<Window x:Class="AIGeekTuner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding Title}" Height="760" Width="1180"
        MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="8"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource ShellBackgroundBrush}"
                BorderBrush="#3378BB" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="22,28,18,28">
                    <TextBlock Text="AI-GeekTuner" FontSize="21" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="AI 硬件诊断工具箱" FontSize="11"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="10,0">
                    <TextBlock Text="工具箱" Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11" Margin="12,0,0,10"/>
                    <Button Content="▣   仪表盘" Command="{Binding ShowDashboardCommand}"
                            Style="{StaticResource NavigationSelectedableStyle}"
                            Tag="Dashboard" Margin="0,2"/>
                    <Button Content="▤   硬件信息" Command="{Binding ShowHardwareCommand}"
                            Style="{StaticResource NavigationSelectedableStyle}"
                            Tag="Hardware" Margin="0,2"/>
                    <Button Content="✦   AI 智能诊断" Command="{Binding ShowDiagnosisCommand}"
                            Style="{StaticResource NavigationSelectedableStyle}"
                            Tag="Diagnosis" Margin="0,2"/>
                    <Button Content="◉   数据录制" Command="{Binding ShowSessionsCommand}"
                            Style="{StaticResource NavigationSelectedableStyle}"
                            Tag="Sessions" Margin="0,2"/>
                    <Button Content="▧   诊断报告" Command="{Binding ShowResultCommand}"
                            Style="{StaticResource NavigationSelectedableStyle}"
                            Tag="Result" Margin="0,2"/>
                    <Button Content="▤   日志管理" Command="{Binding ShowHistoryCommand}"
                            Style="{StaticResource NavigationSelectedableStyle}"
                            Tag="History" Margin="0,2"/>
                    <Button Content="⚙   设置" Command="{Binding ShowSettingsCommand}"
                            Style="{StaticResource NavigationSelectedableStyle}"
                            Tag="Settings" Margin="0,2"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="22,18,18,22">
                    <Border Height="1" Background="#3978B5" Margin="0,0,0,14"/>
                    <TextBlock Text="LOCAL HARDWARE · AI ASSISTED" FontSize="9"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock Text="v1.0.0 · AI 辅助诊断" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="#24FFFFFF"
                    BorderThickness="0,0,0,1"
                    Padding="16,0,0,0"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <TextBlock Text="{Binding CurrentPageDisplayName}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <StackPanel HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Stretch">
                        <Button x:Name="MinimizeButton"
                                AutomationProperties.Name="最小化"
                                Click="MinimizeButton_Click"
                                Style="{StaticResource WindowCaptionButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid Width="14" Height="14">
                                <Path Data="M 2,8 L 12,8"
                                      Stroke="{DynamicResource PrimaryTextBrush}"
                                      StrokeThickness="1.2"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button x:Name="MaximizeButton"
                                AutomationProperties.Name="最大化 / 还原"
                                Click="MaximizeButton_Click"
                                Style="{StaticResource WindowCaptionButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid Width="14" Height="14">
                                <Path x:Name="MaximizeGlyph"
                                      Data="M 2,2 H 12 V 12 H 2 Z"
                                      Stroke="{DynamicResource PrimaryTextBrush}"
                                      StrokeThickness="1.1"
                                      Fill="Transparent"/>
                                <Path x:Name="RestoreGlyph"
                                      Data="M 4,2 H 12 V 10 H 4 Z M 2,4 H 10 V 12 H 2 Z"
                                      Stroke="{DynamicResource PrimaryTextBrush}"
                                      StrokeThickness="1.1"
                                      Fill="Transparent"
                                      Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button x:Name="CloseButton"
                                AutomationProperties.Name="关闭"
                                Tag="Close"
                                Click="CloseButton_Click"
                                Style="{StaticResource WindowCaptionButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid Width="14" Height="14">
                                <Path Data="M 2.5,2.5 L 11.5,11.5 M 11.5,2.5 L 2.5,11.5"
                                      Stroke="{DynamicResource PrimaryTextBrush}"
                                      StrokeThickness="1.2"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
