<Page x:Class="AIGeekTuner.Views.Dashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="仪表盘" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="本机硬件与系统状态概览 · 所有字段来自 Windows 实际检测"
                           Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource ToolCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="设备型号" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock Text="{Binding Hardware.DeviceModel}" Style="{StaticResource InfoValueStyle}"
                                   FontSize="15" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource ToolCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="系统信息" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock Text="{Binding Hardware.SystemSummary}" Style="{StaticResource InfoValueStyle}"
                                   FontSize="15" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource ToolCardStyle}">
                    <StackPanel>
                        <TextBlock Text="运行时间" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock Text="{Binding Hardware.UptimeDisplay}" Style="{StaticResource InfoValueStyle}"
                                   FontSize="15" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding Hardware.LastBootDisplay}" Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource ToolCardStyle}" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="电脑详细信息" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16"/>
                    <Grid Grid.Row="1">
                        <!-- Static Rich Inventory is the only normal presentation.
                             Loading uses the same final Chinese row shape; the
                             retired five-row English layout is failure-only. -->
                        <ItemsControl ItemsSource="{Binding Hardware.DashboardDetailRows}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Hardware.HasInventoryError}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="2" BorderBrush="#4D9BDD" BorderThickness="0,0,0,1"/>
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontWeight="SemiBold" Margin="0,14"
                                                   VerticalAlignment="Top"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                   Style="{StaticResource InfoValueStyle}" Margin="0,14"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Failure-only compatibility fallback.  It cannot be
                             visible during ordinary asynchronous startup. -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Hardware.HasInventoryError}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="#4D9BDD" BorderThickness="0,0,0,1"/>
                            <TextBlock Grid.Row="0" Text="CPU" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,14"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Hardware.CpuName}" Style="{StaticResource InfoValueStyle}" Margin="0,14"/>

                            <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="#4D9BDD" BorderThickness="0,0,0,1"/>
                            <TextBlock Grid.Row="1" Text="GPU" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,14"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Hardware.GpuNames}" Style="{StaticResource InfoValueStyle}" Margin="0,14"/>

                            <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="#4D9BDD" BorderThickness="0,0,0,1"/>
                            <TextBlock Grid.Row="2" Text="Memory" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,14"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoValueStyle}" Margin="0,14">
                                <Run Text="{Binding Hardware.MemoryCapacity, Mode=OneWay}"/><Run Text="  ·  "/>
                                <Run Text="{Binding Hardware.MemoryManufacturers, Mode=OneWay}"/><Run Text="  ·  "/>
                                <Run Text="{Binding Hardware.MemorySpeeds, Mode=OneWay}"/>
                            </TextBlock>

                            <Border Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="#4D9BDD" BorderThickness="0,0,0,1"/>
                            <TextBlock Grid.Row="3" Text="Motherboard" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,14"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Hardware.Motherboard}" Style="{StaticResource InfoValueStyle}" Margin="0,14"/>

                            <TextBlock Grid.Row="4" Text="Operating System" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,14"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Hardware.OperatingSystem}" Style="{StaticResource InfoValueStyle}" Margin="0,14"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
