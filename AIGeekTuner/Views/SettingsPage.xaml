<Page x:Class="AIGeekTuner.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SettingsPage" Background="Transparent">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="SettingsCardStyle" TargetType="Border"
               BasedOn="{StaticResource ToolCardStyle}">
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Background" Value="#12FFFFFF"/>
        </Style>

        <Style x:Key="SettingsRowStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,11"/>
        </Style>

        <Style x:Key="SettingsValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SettingsHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ABDCEA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="17"/>
        </Style>

        <!-- 输入框：沿用诊断页输入的配色语言，仅调整内边距适配行高 -->
        <Style x:Key="SettingsInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#A62678A3"/>
            <Setter Property="Foreground" Value="#F4FCFF"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#608CDFF1"/>
            <Setter Property="BorderBrush" Value="#48B8E6F5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="34"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#B6EEFBFF"/>
                    <Setter Property="Background" Value="#B52A759C"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.62"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 可编辑模型下拉：紧凑深色模板（仅覆盖此页），支持手输/下拉/键盘 -->
        <Style x:Key="ModelComboStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F4FCFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="#A62678A3"
                                          BorderBrush="#48B8E6F5"
                                          BorderThickness="1"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Root"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="2">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,10,0" Data="M0,0 L4,4 8,0 Z"
                                                  Fill="#BEE7F5"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#B52A759C"/>
                                                <Setter TargetName="Root" Property="BorderBrush" Value="#B6EEFBFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- 非编辑态（selection-only）的选中内容展示：
                                 默认模板靠它显示 SelectedItem/DisplayMemberPath 结果；
                                 旧模板缺失导致闭合状态永远空白（V2-M5.1A.1 修复）。 -->
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="8,0,26,0"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="#F4FCFF"
                                              TextElement.FontSize="13"/>

                            <TextBox x:Name="PART_EditableTextBox"
                                     Margin="6,4,26,4"
                                     Background="Transparent"
                                     Foreground="#F4FCFF"
                                     CaretBrush="White"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Background="#123B63"
                                        BorderBrush="#48B8E6F5"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="220">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#F4FCFF"/>
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="Background" Value="#123B63"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#2A759C"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="#C6EEFA"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                    <Setter Property="Foreground" Value="#A9F2D0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                    <Setter Property="Foreground" Value="#FFE08A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                    <Setter Property="Foreground" Value="#FFD1D1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#245A8E"/>
            <Setter Property="Foreground" Value="#C6EEFA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="94" Height="26">
                            <Border x:Name="Track" Width="44" Height="22"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    CornerRadius="11" Background="{TemplateBinding Background}">
                                <Ellipse x:Name="Thumb" Width="16" Height="16"
                                         Fill="White" Margin="3"
                                         HorizontalAlignment="Left"/>
                            </Border>
                            <TextBlock x:Name="StateText" Text="关闭"
                                       Margin="54,0,0,0" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontWeight="SemiBold"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#67D6ED"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="StateText" Property="Text" Value="开启"/>
                                <Setter TargetName="StateText" Property="Foreground" Value="#A9F2D0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,24,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="配置 AI 服务提供方与诊断参数，保存后下一次诊断立即生效"
                           Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>

            <!-- 02 AI 服务提供方（V2-M5.1A：Provider 配置；运行时切换在 M5.1B 接入） -->
            <Border Grid.Row="2" Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="AI 服务提供方" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="「当前使用」的 Provider 将用于 AI 智能诊断与数据会话 AI 分析；「当前编辑」只是设置草稿。"
                               Style="{StaticResource SettingsHintStyle}" Margin="0,4,0,10"/>

                    <StackPanel IsEnabled="{Binding Providers.IsAvailable}">
                        <!-- V2-M5.1B（Gate M）：当前使用（Active）Provider——下一次 AI 请求实际用谁 -->
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="当前使用 AI" Style="{StaticResource InfoLabelStyle}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Providers.ActiveProviderDisplay}"
                                           Style="{StaticResource StatusTextStyle}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="● 当前正在使用"
                                               Foreground="#7BE8A8" FontSize="12" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Providers.IsEditingProfileActive}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button x:Name="ActivateProviderButton"
                                            Content="设为当前使用"
                                            Command="{Binding Providers.ActivateCurrentProfileCommand}"
                                            Padding="12,6"
                                            ToolTip="把当前编辑的已保存 Provider 设为下一次 AI 请求使用的服务提供方">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Providers.CanActivateCurrentProfile}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 选择 / 添加 / 删除 -->
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="当前编辑" Style="{StaticResource InfoLabelStyle}"/>
                                <ComboBox x:Name="ProviderSelectorCombo"
                                          Grid.Column="1"
                                          Style="{StaticResource ModelComboStyle}"
                                          IsEditable="False"
                                          ItemsSource="{Binding Providers.SelectorItems}"
                                          SelectedItem="{Binding Providers.SelectedItem}"
                                          Margin="0,0,10,0">
                                    <!-- V2-M5.1A.2：SelectionBoxItemTemplate 只取显式 ItemTemplate；
                                         DisplayMemberPath 的生成模板不进入闭合态展示，会回退 object.ToString()。
                                         显式模板保证下拉项与闭合态使用同一 display contract（Label=DisplayName）。 -->
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button x:Name="AddProviderButton"
                                        Grid.Column="2" Content="＋ 添加 Provider"
                                        Click="AddProviderButton_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,6" Margin="0,0,8,0"
                                        ToolTip="从预设新建 Provider 草稿">
                                    <Button.ContextMenu>
                                        <ContextMenu Background="#123B63" BorderBrush="#48B8E6F5">
                                            <MenuItem Header="Ollama"
                                                      Command="{Binding Providers.CreateOllamaProviderCommand}"
                                                      Foreground="#F4FCFF"/>
                                            <MenuItem Header="LM Studio"
                                                      Command="{Binding Providers.CreateLmStudioProviderCommand}"
                                                      Foreground="#F4FCFF"/>
                                            <MenuItem Header="自定义 OpenAI Compatible"
                                                      Command="{Binding Providers.CreateCustomProviderCommand}"
                                                      Foreground="#F4FCFF"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <TextBlock Grid.Column="3" Text="有未保存更改"
                                           Foreground="#FFE08A" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Providers.HasUnsavedChanges}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="4" Content="删除 Provider"
                                        Command="{Binding Providers.DeleteProviderCommand}"
                                        IsEnabled="{Binding Providers.HasSelection}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="14,7"/>
                            </Grid>
                        </Border>

                        <Border Padding="0,4,0,0"
                                IsEnabled="{Binding Providers.HasSelection}">
                        <StackPanel>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="提供方名称" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource SettingsInputStyle}"
                                             Text="{Binding Providers.DisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="类型" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Providers.KindDisplay}"
                                               Style="{StaticResource SettingsValueStyle}"
                                               ToolTip="Provider 协议类型；新 Provider 的 ID 在下方“高级设置”中查看。"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="API 地址" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource SettingsInputStyle}"
                                             Text="{Binding Providers.BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="API 根地址，例如 http://127.0.0.1:11434 或 http://127.0.0.1:1234/v1"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsRowStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="API Key" Style="{StaticResource InfoLabelStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Providers.CredentialStatusText}"
                                                   Style="{StaticResource SettingsHintStyle}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button Grid.Column="2" Content="更新密钥"
                                                Command="{Binding Providers.BeginKeyUpdateCommand}"
                                                Click="ProviderBeginKeyUpdate_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="12,6" Margin="0,0,8,0"/>
                                        <Button Grid.Column="3" Content="清除"
                                                Command="{Binding Providers.ClearKeyCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="12,6"/>
                                    </Grid>
                                    <PasswordBox x:Name="ProviderApiKeyBox"
                                                 Background="#A62678A3" Foreground="#F4FCFF"
                                                 CaretBrush="White" BorderBrush="#48B8E6F5"
                                                 BorderThickness="1" Padding="8,5" MinHeight="34"
                                                 Margin="150,8,0,0"
                                                 Visibility="{Binding Providers.IsKeyEditorVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 PasswordChanged="ProviderApiKey_PasswordChanged"/>
                                    <TextBlock Text="已保存的密钥不会显示明文；输入新密钥后点击“保存 Provider”即替换。"
                                               Style="{StaticResource SettingsHintStyle}" Margin="150,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsRowStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="模型" Style="{StaticResource InfoLabelStyle}"/>
                                        <ComboBox x:Name="ProviderModelCombo"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModelComboStyle}"
                                                  IsEditable="True"
                                                  ItemsSource="{Binding Providers.ModelOptions}"
                                                  Text="{Binding Providers.ModelText, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="{Binding Providers.ModelText, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,0,10,0"/>
                                        <Button Grid.Column="2" Content="刷新模型"
                                                Command="{Binding Providers.RefreshModelsCommand}"
                                                Style="{StaticResource TechButtonStyle}"
                                                Padding="14,7"/>
                                    </Grid>
                                    <TextBlock Text="可选择已发现的模型，或直接手动输入模型 ID；刷新不会清除手动输入。"
                                               Style="{StaticResource SettingsHintStyle}" Margin="150,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="默认模型" Style="{StaticResource InfoLabelStyle}"/>
                                    <ComboBox x:Name="DefaultModelCombo"
                                              Grid.Column="1"
                                              Style="{StaticResource ModelComboStyle}"
                                              IsEditable="False"
                                              ItemsSource="{Binding Providers.ModelOptions}"
                                              SelectedItem="{Binding Providers.DefaultModelText}"
                                              ToolTip="只能从该 Provider 的模型列表中选择；新模型请先在“模型”栏输入并保存"/>
                                </Grid>
                            </Border>

                            <Border Padding="0,11,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="连接状态" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Providers.StatusMessage}"
                                               Style="{StaticResource StatusTextStyle}"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button Grid.Column="2" Content="测试连接"
                                            Command="{Binding Providers.TestConnectionCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="16,8"/>
                                </Grid>
                            </Border>

                            <Expander x:Name="AdvancedExpander"
                                      Margin="0,8,0,0" Header="高级设置" Foreground="#ABDCEA" FontSize="12">
                                <StackPanel Margin="0,6,0,0">
                                    <Border Style="{StaticResource SettingsRowStyle}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="结构化输出" Style="{StaticResource InfoLabelStyle}"/>
                                                <ComboBox x:Name="StructuredOutputCombo"
                                                          Grid.Column="1"
                                                          Style="{StaticResource ModelComboStyle}"
                                                          IsEditable="False"
                                                          ItemsSource="{Binding Providers.StructuredOutputModes}"
                                                          SelectedValuePath="Mode"
                                                          SelectedValue="{Binding Providers.SelectedStructuredOutputMode}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Label}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button Grid.Column="2" Content="测试结构化输出"
                                                        Command="{Binding Providers.TestStructuredOutputCommand}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="12,7"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Providers.StructuredProbeText}"
                                                       Style="{StaticResource SettingsHintStyle}" Margin="150,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{Binding Providers.ProviderIdDisplay, StringFormat='Provider ID：{0}（创建后不可修改）'}"
                                               Style="{StaticResource SettingsHintStyle}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock DataContext="{Binding Providers}"
                                   Text="{Binding StatusMessage}"
                                   Style="{StaticResource StatusTextStyle}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="保存 Provider"
                                Command="{Binding Providers.SaveProviderCommand}"
                                Style="{StaticResource TechButtonStyle}"
                                Padding="22,9" FontWeight="Bold"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="导出 Provider 配置"
                                Command="{Binding ExportProvidersCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="14,7" Margin="0,0,8,0"/>
                        <Button Content="导入 Provider 配置"
                                Command="{Binding ImportProvidersCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="14,7"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 02 诊断偏好 -->
            <Border Grid.Row="3" Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="诊断偏好" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="影响下一次诊断的输入处理方式"
                               Style="{StaticResource SettingsHintStyle}" Margin="0,4,0,10"/>

                    <Border Style="{StaticResource SettingsRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="请求超时" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SettingsInputStyle}"
                                     Text="{Binding TimeoutSecondsText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="2" Text="秒" Foreground="#ABDCEA"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRowStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="诊断输入长度" Style="{StaticResource InfoLabelStyle}"/>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource SettingsInputStyle}"
                                         Text="{Binding MaxLogLengthText, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="2" Text="字符" Foreground="#ABDCEA"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                            <TextBlock Text="发送给 AI 分析的最大日志文本长度（超出部分保留开头与结尾）。文件大小限制与此无关。"
                                       Style="{StaticResource SettingsHintStyle}" Margin="150,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsRowStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="录制采样间隔" Style="{StaticResource InfoLabelStyle}"/>
                                <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="140"
                                          x:Name="RecordingIntervalCombo"
                                          Style="{StaticResource ModelComboStyle}" IsEditable="False"
                                          SelectionChanged="RecordingInterval_SelectionChanged">
                                    <ComboBoxItem Tag="1000" Content="1 秒"/>
                                    <ComboBoxItem Tag="2000" Content="2 秒（推荐）"/>
                                    <ComboBoxItem Tag="5000" Content="5 秒"/>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="仅作用于新的录制会话；正在录制的会话保持开始时的间隔。"
                                       Style="{StaticResource SettingsHintStyle}" Margin="150,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsRowStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="启用 GPT-SoVITS" Style="{StaticResource InfoLabelStyle}"/>
                                <ToggleButton Grid.Column="1"
                                              IsChecked="{Binding VoiceEnabled}"
                                              Style="{StaticResource SettingsToggleStyle}"
                                              HorizontalAlignment="Left"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsRowStyle}">
                        <StackPanel>
                            <TextBlock Text="服务地址" Style="{StaticResource InfoLabelStyle}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding VoiceEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingsInputStyle}"/>
                            <TextBlock Text="参考音频路径（必须为 GPT-SoVITS 服务进程可访问的路径）"
                                       Style="{StaticResource InfoLabelStyle}" Margin="0,8,0,4"/>
                            <TextBox Text="{Binding VoiceReferenceAudioPath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingsInputStyle}"/>
                            <TextBlock Text="参考音频转写文本"
                                       Style="{StaticResource InfoLabelStyle}" Margin="0,8,0,4"/>
                            <TextBox Text="{Binding VoicePromptText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingsInputStyle}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="参考音频语言"
                                           Style="{StaticResource InfoLabelStyle}"/>
                                <ComboBox x:Name="VoicePromptLangCombo"
                                          Grid.Column="1" SelectedValuePath="Tag"
                                          SelectedValue="{Binding VoicePromptLang}"
                                          Style="{StaticResource ModelComboStyle}"
                                          IsEditable="False"
                                          HorizontalAlignment="Left" MinWidth="120">
                                    <ComboBoxItem Content="中文（zh）" Tag="zh"/>
                                    <ComboBoxItem Content="日语（ja）" Tag="ja"/>
                                    <ComboBoxItem Content="英语（en）" Tag="en"/>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="合成语速"
                                           Style="{StaticResource InfoLabelStyle}"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding VoiceSpeedFactorText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingsInputStyle}" MaxWidth="120"
                                         HorizontalAlignment="Left"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 03 硬件数据源（V2-M1） -->
            <Border Grid.Row="4" Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="硬件数据源" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="AIGeekTuner 可读取可用的外部硬件监控数据，并保留数据来源；外部软件需用户自行安装与启用"
                                       Style="{StaticResource SettingsHintStyle}" Margin="0,4,10,10"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding RefreshDataSourceButtonText}"
                                Command="{Binding RefreshDataSourcesCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="14,7" VerticalAlignment="Top"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding DataSourceStatuses}" Margin="0,2,0,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding StatusGlyph}"
                                                   FontSize="12" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#6FA9C1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusKind}" Value="Ready">
                                                            <Setter Property="Foreground" Value="#A9F2D0"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKind}" Value="Degraded">
                                                            <Setter Property="Foreground" Value="#FFE08A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKind}" Value="NeedsConfiguration">
                                                            <Setter Property="Foreground" Value="#FFE08A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                                            <Setter Property="Foreground" Value="#FFD1D1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding SourceName}"
                                                   Foreground="#ECFAFF" FontSize="12"
                                                   FontWeight="SemiBold" Margin="9,0,0,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DetailLine}"
                                                   Foreground="#ABDCEA" FontSize="11"
                                                   TextWrapping="Wrap" Margin="14,0,0,0"
                                                   VerticalAlignment="Center" MaxWidth="430"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding DataSourceStatusLine}"
                               Style="{StaticResource SettingsHintStyle}" Margin="0,4,0,0"/>
                    <TextBlock Text="HWiNFO / AIDA64 为可选数据源，未安装时内置传感器功能完全正常。"
                               Style="{StaticResource SettingsHintStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- 04 历史与数据 -->
            <Border Grid.Row="5" Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="历史与数据" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="诊断记录与本地数据均保留在本机"
                               Style="{StaticResource SettingsHintStyle}" Margin="0,4,0,10"/>

                    <Border Style="{StaticResource SettingsRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="自动保存诊断历史" Style="{StaticResource InfoLabelStyle}"/>
                            <ToggleButton Grid.Column="1"
                                          IsChecked="{Binding AutoSaveDiagnosisHistory}"
                                          Style="{StaticResource SettingsToggleStyle}"
                                          HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>

                    <Border Padding="0,11,0,0">
                        <StackPanel>
                            <TextBlock Text="本地数据目录" Style="{StaticResource InfoLabelStyle}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding LocalDataDirectory}"
                                       Style="{StaticResource SettingsValueStyle}"
                                       FontFamily="Consolas" FontSize="11"/>
                            <Button Content="打开本地数据目录"
                                    Command="{Binding OpenDataDirectoryCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="16,8" Margin="0,10,0,0"
                                    HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="导出应用设置"
                                        Command="{Binding ExportSettingsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="14,7" Margin="0,0,8,0"/>
                                <Button Content="导入应用设置"
                                        Command="{Binding ImportSettingsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="14,7"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Padding="0,14,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="关于软件" Style="{StaticResource SectionTitleStyle}"/>
                                <Border HorizontalAlignment="Right" Background="#1BFFFFFF"
                                        Padding="9,4" VerticalAlignment="Top">
                                    <TextBlock Text="v1.0.0" Foreground="#DDF8FF" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="AI PC 硬件故障辅助诊断工具。硬件采集与 SafetyGuard 在本机完成；若使用云端 AI Provider，诊断上下文将发送至所配置的 Provider。"
                                       Style="{StaticResource SettingsHintStyle}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 底部保存区 -->
            <Grid Grid.Row="6" Margin="0,18,0,0">
                <!-- V2-M5.1B（Gate N）：保存状态展示从已移除的旧 Ollama 卡片迁移到这里。 -->
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource StatusTextStyle}"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Margin="0,0,150,0"/>
                <Button Content="保存设置"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource TechButtonStyle}"
                        HorizontalAlignment="Right"
                        Padding="28,10" MinWidth="140" MinHeight="40"
                        FontWeight="Bold" FontSize="14"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
