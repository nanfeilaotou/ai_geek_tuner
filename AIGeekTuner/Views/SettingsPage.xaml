<Page x:Class="AIGeekTuner.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SettingsPage" Background="Transparent">
    <Page.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border"
               BasedOn="{StaticResource ToolCardStyle}">
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Background" Value="#12FFFFFF"/>
        </Style>

        <Style x:Key="SettingsRowStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,11"/>
        </Style>

        <Style x:Key="SettingsValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SettingsHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ABDCEA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="17"/>
        </Style>

        <!-- 输入框：沿用诊断页输入的配色语言，仅调整内边距适配行高 -->
        <Style x:Key="SettingsInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#A62678A3"/>
            <Setter Property="Foreground" Value="#F4FCFF"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#608CDFF1"/>
            <Setter Property="BorderBrush" Value="#48B8E6F5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="34"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#B6EEFBFF"/>
                    <Setter Property="Background" Value="#B52A759C"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.62"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 可编辑模型下拉：紧凑深色模板（仅覆盖此页），支持手输/下拉/键盘 -->
        <Style x:Key="ModelComboStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F4FCFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="#A62678A3"
                                          BorderBrush="#48B8E6F5"
                                          BorderThickness="1"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Root"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="2">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,10,0" Data="M0,0 L4,4 8,0 Z"
                                                  Fill="#BEE7F5"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#B52A759C"/>
                                                <Setter TargetName="Root" Property="BorderBrush" Value="#B6EEFBFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <TextBox x:Name="PART_EditableTextBox"
                                     Margin="6,4,26,4"
                                     Background="Transparent"
                                     Foreground="#F4FCFF"
                                     CaretBrush="White"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Background="#123B63"
                                        BorderBrush="#48B8E6F5"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="220">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#F4FCFF"/>
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="Background" Value="#123B63"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#2A759C"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="#C6EEFA"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                    <Setter Property="Foreground" Value="#A9F2D0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                    <Setter Property="Foreground" Value="#FFE08A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                    <Setter Property="Foreground" Value="#FFD1D1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#245A8E"/>
            <Setter Property="Foreground" Value="#C6EEFA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="94" Height="26">
                            <Border x:Name="Track" Width="44" Height="22"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    CornerRadius="11" Background="{TemplateBinding Background}">
                                <Ellipse x:Name="Thumb" Width="16" Height="16"
                                         Fill="White" Margin="3"
                                         HorizontalAlignment="Left"/>
                            </Border>
                            <TextBlock x:Name="StateText" Text="关闭"
                                       Margin="54,0,0,0" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontWeight="SemiBold"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#67D6ED"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="StateText" Property="Text" Value="开启"/>
                                <Setter TargetName="StateText" Property="Foreground" Value="#A9F2D0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,24,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="配置本地 AI 服务与诊断参数，保存后下一次诊断立即生效"
                           Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>

            <!-- 01 AI 服务 -->
            <Border Grid.Row="1" Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="AI 服务" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="本机或局域网 Ollama 服务地址与模型选择"
                               Style="{StaticResource SettingsHintStyle}" Margin="0,4,0,10"/>

                    <Border Style="{StaticResource SettingsRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="服务地址" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SettingsInputStyle}"
                                     Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRowStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="当前模型" Style="{StaticResource InfoLabelStyle}"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource ModelComboStyle}"
                                          ItemsSource="{Binding AvailableModels}"
                                          Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,10,0"/>
                                <Button Grid.Column="2" Content="刷新模型"
                                        Command="{Binding RefreshModelsCommand}"
                                        Style="{StaticResource TechButtonStyle}"
                                        Padding="14,7"/>
                            </Grid>
                            <TextBlock Text="可直接输入尚未安装的模型名；刷新不会清除手动输入。"
                                       Style="{StaticResource SettingsHintStyle}" Margin="150,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Padding="0,11,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="连接检测" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                                       Style="{StaticResource StatusTextStyle}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Grid.Column="2" Content="测试连接"
                                    Command="{Binding TestConnectionCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="16,8"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 02 诊断偏好 -->
            <Border Grid.Row="2" Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="诊断偏好" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="影响下一次诊断的输入处理方式"
                               Style="{StaticResource SettingsHintStyle}" Margin="0,4,0,10"/>

                    <Border Style="{StaticResource SettingsRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="请求超时" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SettingsInputStyle}"
                                     Text="{Binding TimeoutSecondsText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="2" Text="秒" Foreground="#ABDCEA"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRowStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="诊断输入长度" Style="{StaticResource InfoLabelStyle}"/>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource SettingsInputStyle}"
                                         Text="{Binding MaxLogLengthText, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="2" Text="字符" Foreground="#ABDCEA"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                            <TextBlock Text="发送给 AI 分析的最大日志文本长度（超出部分保留开头与结尾）。文件大小限制与此无关。"
                                       Style="{StaticResource SettingsHintStyle}" Margin="150,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsRowStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="严格 JSON 输出" Style="{StaticResource InfoLabelStyle}"/>
                                <ToggleButton Grid.Column="1"
                                              IsChecked="{Binding UseJsonFormat}"
                                              Style="{StaticResource SettingsToggleStyle}"
                                              HorizontalAlignment="Left"/>
                            </Grid>
                            <TextBlock Text="提高本地模型结构化诊断结果的稳定性。"
                                       Style="{StaticResource SettingsHintStyle}" Margin="150,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 03 历史与数据 -->
            <Border Grid.Row="3" Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="历史与数据" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="诊断记录与本地数据均保留在本机"
                               Style="{StaticResource SettingsHintStyle}" Margin="0,4,0,10"/>

                    <Border Style="{StaticResource SettingsRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="自动保存诊断历史" Style="{StaticResource InfoLabelStyle}"/>
                            <ToggleButton Grid.Column="1"
                                          IsChecked="{Binding AutoSaveDiagnosisHistory}"
                                          Style="{StaticResource SettingsToggleStyle}"
                                          HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>

                    <Border Padding="0,11,0,0">
                        <StackPanel>
                            <TextBlock Text="本地数据目录" Style="{StaticResource InfoLabelStyle}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding LocalDataDirectory}"
                                       Style="{StaticResource SettingsValueStyle}"
                                       FontFamily="Consolas" FontSize="11"/>
                            <Button Content="打开本地数据目录"
                                    Command="{Binding OpenDataDirectoryCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="16,8" Margin="0,10,0,0"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <Border Padding="0,14,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="关于软件" Style="{StaticResource SectionTitleStyle}"/>
                                <Border HorizontalAlignment="Right" Background="#1BFFFFFF"
                                        Padding="9,4" VerticalAlignment="Top">
                                    <TextBlock Text="v1.0.0" Foreground="#DDF8FF" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="本地 AI PC 硬件故障辅助诊断工具。诊断流程完全在本机完成：硬件信息、日志与推理请求均不经过云端。"
                                       Style="{StaticResource SettingsHintStyle}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 底部保存区 -->
            <Grid Grid.Row="4" Margin="0,18,0,0">
                <Button Content="保存设置"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource TechButtonStyle}"
                        HorizontalAlignment="Right"
                        Padding="28,10" MinWidth="140" MinHeight="40"
                        FontWeight="Bold" FontSize="14"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
