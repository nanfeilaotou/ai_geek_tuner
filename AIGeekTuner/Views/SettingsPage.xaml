<Page x:Class="AIGeekTuner.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SettingsPage" Background="Transparent">
    <Page.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border"
               BasedOn="{StaticResource ToolCardStyle}">
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Background" Value="#12FFFFFF"/>
        </Style>

        <Style x:Key="SettingsRowStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,11"/>
        </Style>

        <Style x:Key="SettingsValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SettingsHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ABDCEA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="17"/>
        </Style>

        <Style x:Key="PrivacyItemStyle" TargetType="Border">
            <Setter Property="Background" Value="#0BFFFFFF"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="TechnologyTagStyle" TargetType="Border">
            <Setter Property="Background" Value="#16FFFFFF"/>
            <Setter Property="BorderBrush" Value="#28FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="0,0,7,7"/>
        </Style>

        <Style x:Key="SettingsToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#245A8E"/>
            <Setter Property="Foreground" Value="#C6EEFA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="94" Height="26">
                            <Border x:Name="Track" Width="44" Height="22"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    CornerRadius="11" Background="{TemplateBinding Background}">
                                <Ellipse x:Name="Thumb" Width="16" Height="16"
                                         Fill="White" Margin="3"
                                         HorizontalAlignment="Left"/>
                            </Border>
                            <TextBlock x:Name="StateText" Text="关闭"
                                       Margin="54,0,0,0" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontWeight="SemiBold"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#67D6ED"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="StateText" Property="Text" Value="开启"/>
                                <Setter TargetName="StateText" Property="Foreground" Value="#A9F2D0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,24,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="管理本地 AI 服务、诊断偏好与本机数据"
                           Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.04*" MinWidth="350"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="0.96*" MinWidth="350"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="AI 服务状态" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="检测本机 Ollama 服务与模型配置"
                                               Style="{StaticResource SettingsHintStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Padding="11,6" Background="#18FFFFFF"
                                        VerticalAlignment="Center" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" Margin="0,0,8,0"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#A9D9E9"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OllamaStatus}" Value="在线">
                                                            <Setter Property="Fill" Value="#A9F2D0"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding OllamaStatus}" Value="离线">
                                                            <Setter Property="Fill" Value="#FF9F9F"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding OllamaStatus}" Value="检测中">
                                                            <Setter Property="Fill" Value="#FFE08A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding OllamaStatus}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#D7F4FC"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OllamaStatus}" Value="在线">
                                                            <Setter Property="Foreground" Value="#A9F2D0"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding OllamaStatus}" Value="离线">
                                                            <Setter Property="Foreground" Value="#FFB2B2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding OllamaStatus}" Value="检测中">
                                                            <Setter Property="Foreground" Value="#FFE08A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="124"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="当前模型" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ModelName}"
                                               Style="{StaticResource SettingsValueStyle}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="124"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="服务地址" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BaseUrl}"
                                               Style="{StaticResource SettingsValueStyle}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="124"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="请求超时" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Timeout}"
                                               Style="{StaticResource SettingsValueStyle}"/>
                                </Grid>
                            </Border>
                            <Border Padding="0,11,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="124"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="最后检测时间" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LastCheckedAtText}"
                                               Style="{StaticResource SettingsValueStyle}"/>
                                </Grid>
                            </Border>

                            <Button Content="{Binding TestConnectionButtonText}"
                                    Command="{Binding TestConnectionCommand}"
                                    Style="{StaticResource TechButtonStyle}"
                                    Margin="0,17,0,0" HorizontalAlignment="Left"
                                    Padding="22,9" MinWidth="118"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Text="诊断偏好" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="控制诊断输入与本地报告保存行为"
                                       Style="{StaticResource SettingsHintStyle}" Margin="0,4,0,10"/>

                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="输出语言" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OutputLanguage}"
                                               Style="{StaticResource SettingsValueStyle}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="日志最大输入长度" Style="{StaticResource InfoLabelStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MaxLogLength}"
                                                   Style="{StaticResource SettingsValueStyle}"/>
                                    </Grid>
                                    <TextBlock Text="超出限制时将保留日志头部和尾部内容，并明确告知 AI 日志已截断。"
                                               Style="{StaticResource SettingsHintStyle}" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Padding="0,11,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="自动保存诊断记录" Style="{StaticResource InfoLabelStyle}"/>
                                    <StackPanel Grid.Column="1">
                                        <ToggleButton IsChecked="{Binding AutoSaveDiagnosisHistory, Mode=OneWay}"
                                                      Command="{Binding SetAutoSaveCommand}"
                                                      CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                                      Style="{StaticResource SettingsToggleStyle}"/>
                                        <TextBlock Text="{Binding SettingsSaveStatus}"
                                                   Style="{StaticResource SettingsHintStyle}"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="数据与隐私" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="应用数据与诊断上下文均保留在本机"
                                       Style="{StaticResource SettingsHintStyle}" Margin="0,4,0,13"/>

                            <Border Style="{StaticResource PrivacyItemStyle}">
                                <TextBlock Text="✓  AI 推理通过本机 Ollama 完成" Foreground="White"/>
                            </Border>
                            <Border Style="{StaticResource PrivacyItemStyle}">
                                <TextBlock Text="✓  日志默认不会上传到外部服务" Foreground="White"/>
                            </Border>
                            <Border Style="{StaticResource PrivacyItemStyle}">
                                <TextBlock Text="✓  硬件信息仅作为当前诊断上下文" Foreground="White"/>
                            </Border>
                            <Border Style="{StaticResource PrivacyItemStyle}">
                                <TextBlock Text="✓  历史诊断记录保存在本地" Foreground="White"/>
                            </Border>

                            <TextBlock Text="本地数据目录" Style="{StaticResource InfoLabelStyle}"
                                       Margin="0,7,0,4"/>
                            <TextBlock Text="{Binding LocalDataDirectory}"
                                       Style="{StaticResource SettingsValueStyle}"
                                       FontFamily="Consolas" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                                <Button Content="打开本地数据目录"
                                        Command="{Binding OpenDataDirectoryCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="16,8"/>
                                <TextBlock Text="{Binding DataDirectoryStatus}"
                                           Style="{StaticResource SettingsHintStyle}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="关于软件" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="AI-GeekTuner" Foreground="White"
                                               FontSize="20" FontWeight="SemiBold" Margin="0,13,0,0"/>
                                    <TextBlock Text="本地 AI PC 硬件故障辅助诊断工具。"
                                               Style="{StaticResource SettingsHintStyle}" Margin="0,5,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1BFFFFFF" Padding="11,6"
                                        VerticalAlignment="Top" Margin="12,0,0,0">
                                    <TextBlock Text="V1.0" Foreground="#DDF8FF" FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <Border Height="1" Background="#18FFFFFF" Margin="0,17,0,14"/>
                            <TextBlock Text="技术组件" Style="{StaticResource InfoLabelStyle}"
                                       Margin="0,0,0,9"/>
                            <WrapPanel>
                                <Border Style="{StaticResource TechnologyTagStyle}">
                                    <TextBlock Text=".NET 8 / WPF" Foreground="White"/>
                                </Border>
                                <Border Style="{StaticResource TechnologyTagStyle}">
                                    <TextBlock Text="Ollama" Foreground="White"/>
                                </Border>
                                <Border Style="{StaticResource TechnologyTagStyle}">
                                    <TextBlock Text="Qwen3" Foreground="White"/>
                                </Border>
                                <Border Style="{StaticResource TechnologyTagStyle}">
                                    <TextBlock Text="SafetyGuard" Foreground="White"/>
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="版本信息为本地展示，不包含联网更新检查。"
                                       Style="{StaticResource SettingsHintStyle}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
