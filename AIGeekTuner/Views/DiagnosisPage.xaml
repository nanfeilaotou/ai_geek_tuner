<Page x:Class="AIGeekTuner.Views.DiagnosisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="DiagnosisPage" Background="Transparent">
    <Page.Resources>
        <ControlTemplate x:Key="DiagnosisFlatButtonTemplate" TargetType="Button">
            <Border x:Name="ButtonSurface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <Style x:Key="DiagnosisInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#A62678A3"/>
            <Setter Property="Foreground" Value="#F4FCFF"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#608CDFF1"/>
            <Setter Property="BorderBrush" Value="#48B8E6F5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SpellCheck.IsEnabled" Value="False"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#B6EEFBFF"/>
                    <Setter Property="Background" Value="#B52A759C"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.62"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ImportButtonStyle" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource DiagnosisFlatButtonTemplate}"/>
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#50C3EBF7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#32FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#B7F1FCFF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DiagnosisPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource DiagnosisFlatButtonTemplate}"/>
            <Setter Property="Background" Value="#9BE8F7"/>
            <Setter Property="Foreground" Value="#075581"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,11"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C4F3FB"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#70D7EE"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#38FFFFFF"/>
                    <Setter Property="Foreground" Value="#80FFFFFF"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DiagnosisSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource DiagnosisFlatButtonTemplate}"/>
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="Foreground" Value="#DDF7FF"/>
            <Setter Property="BorderBrush" Value="#48C0E9F5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#25FFFFFF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.38"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DiagnosisStepCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13"/>
            <Setter Property="Opacity" Value="0.64"/>
        </Style>
    </Page.Resources>

    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="AI 智能诊断" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="导入故障日志，由本地 Ollama 分析并经过 SafetyGuard 检查"
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.85*"/>
                <ColumnDefinition Width="0.85*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0DFFFFFF" Margin="0,0,16,0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="68"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="故障日志" Style="{StaticResource SectionTitleStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="{Binding LogInputStatus}" Foreground="#BEE7F5" FontSize="11"
                                           TextTrimming="CharacterEllipsis" MaxWidth="480"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Content="＋  导入 .txt / .log"
                                Command="{Binding SelectFileCommand}"
                                Style="{StaticResource ImportButtonStyle}"/>
                    </Grid>

                    <TextBox Grid.Row="1"
                             Text="{Binding FaultLogText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DiagnosisInputStyle}"
                             AcceptsReturn="True" AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" MinHeight="220"/>

                    <Grid Grid.Row="2" Margin="0,13,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="用户补充描述" Foreground="White" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="可选 · 例如：开启 XMP 后运行游戏约 30 分钟出现蓝屏"
                                   Foreground="#A9DBEC" FontSize="11" Margin="10,2,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <TextBox Grid.Row="3"
                             Text="{Binding UserDescription, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DiagnosisInputStyle}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>

                    <Grid Grid.Row="4" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="开始诊断"
                                Command="{Binding StartDiagnosisCommand}"
                                Style="{StaticResource DiagnosisPrimaryButtonStyle}"
                                MinWidth="132"/>
                        <Button Grid.Column="1" Content="取消"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource DiagnosisSecondaryButtonStyle}"
                                MinWidth="88" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="日志只在本机处理"
                                   Foreground="#9DD6E8" FontSize="11"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#10FFFFFF" Padding="19">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="64"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="诊断状态" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="本地诊断处理流程" Foreground="#A9DBEC" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#20FFFFFF"
                                BorderBrush="#2FFFFFFF" BorderThickness="1" Padding="10,5">
                            <TextBlock Text="{Binding PhaseText}" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#C6E7F2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PhaseText}" Value="正在分析">
                                                <Setter Property="Foreground" Value="#B8F5FF"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PhaseText}" Value="诊断完成">
                                                <Setter Property="Foreground" Value="#B8F4D6"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PhaseText}" Value="诊断失败">
                                                <Setter Property="Foreground" Value="#FFD1D1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,0,0,9">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource DiagnosisStepCardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HardwareStepStatus}" Value="读取中">
                                        <Setter Property="Background" Value="#28A8E9F5"/>
                                        <Setter Property="BorderBrush" Value="#A7EBFAFF"/>
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HardwareStepStatus}" Value="已完成">
                                        <Setter Property="Background" Value="#16A9F2D0"/>
                                        <Setter Property="BorderBrush" Value="#55B8F4D6"/>
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HardwareStepStatus}" Value="失败">
                                        <Setter Property="Background" Value="#20FF8F8F"/>
                                        <Setter Property="BorderBrush" Value="#70FFC2C2"/>
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="15" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="○"/><Setter Property="Foreground" Value="#9CCCDD"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HardwareStepStatus}" Value="读取中"><Setter Property="Text" Value="●"/><Setter Property="Foreground" Value="#C8F8FF"/></DataTrigger>
                                            <DataTrigger Binding="{Binding HardwareStepStatus}" Value="已完成"><Setter Property="Text" Value="✓"/><Setter Property="Foreground" Value="#B8F4D6"/></DataTrigger>
                                            <DataTrigger Binding="{Binding HardwareStepStatus}" Value="失败"><Setter Property="Text" Value="×"/><Setter Property="Foreground" Value="#FFD1D1"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="01  读取硬件" Foreground="White" FontWeight="SemiBold"/>
                                <TextBlock Text="获取本机 WMI 硬件信息" Foreground="#A8D5E5" FontSize="10" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding HardwareStepStatus}" Foreground="#D7F6FF" VerticalAlignment="Center" FontSize="11"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Margin="0,0,0,9">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource DiagnosisStepCardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AiStepStatus}" Value="分析中">
                                        <Setter Property="Background" Value="#28A8E9F5"/><Setter Property="BorderBrush" Value="#A7EBFAFF"/><Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AiStepStatus}" Value="已完成">
                                        <Setter Property="Background" Value="#16A9F2D0"/><Setter Property="BorderBrush" Value="#55B8F4D6"/><Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AiStepStatus}" Value="失败">
                                        <Setter Property="Background" Value="#20FF8F8F"/><Setter Property="BorderBrush" Value="#70FFC2C2"/><Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock FontSize="15" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="○"/><Setter Property="Foreground" Value="#9CCCDD"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AiStepStatus}" Value="分析中"><Setter Property="Text" Value="●"/><Setter Property="Foreground" Value="#C8F8FF"/></DataTrigger>
                                            <DataTrigger Binding="{Binding AiStepStatus}" Value="已完成"><Setter Property="Text" Value="✓"/><Setter Property="Foreground" Value="#B8F4D6"/></DataTrigger>
                                            <DataTrigger Binding="{Binding AiStepStatus}" Value="失败"><Setter Property="Text" Value="×"/><Setter Property="Foreground" Value="#FFD1D1"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="02  调用 Ollama" Foreground="White" FontWeight="SemiBold"/>
                                <TextBlock Text="本地模型生成结构化诊断" Foreground="#A8D5E5" FontSize="10" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding AiStepStatus}" Foreground="#D7F6FF" VerticalAlignment="Center" FontSize="11"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource DiagnosisStepCardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SafetyStepStatus}" Value="已完成">
                                        <Setter Property="Background" Value="#16A9F2D0"/><Setter Property="BorderBrush" Value="#55B8F4D6"/><Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SafetyStepStatus}" Value="失败">
                                        <Setter Property="Background" Value="#20FF8F8F"/><Setter Property="BorderBrush" Value="#70FFC2C2"/><Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock FontSize="15" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="○"/><Setter Property="Foreground" Value="#9CCCDD"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SafetyStepStatus}" Value="已完成"><Setter Property="Text" Value="✓"/><Setter Property="Foreground" Value="#B8F4D6"/></DataTrigger>
                                            <DataTrigger Binding="{Binding SafetyStepStatus}" Value="失败"><Setter Property="Text" Value="×"/><Setter Property="Foreground" Value="#FFD1D1"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="03  SafetyGuard 检查" Foreground="White" FontWeight="SemiBold"/>
                                <TextBlock Text="本地规则复核 AI 建议" Foreground="#A8D5E5" FontSize="10" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding SafetyStepStatus}" Foreground="#D7F6FF" VerticalAlignment="Center" FontSize="11"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Height="1" Background="#20FFFFFF" Margin="0,18,0,14"/>
                    <ProgressBar Grid.Row="5" IsIndeterminate="True"
                                 Foreground="#B9F4FF" Background="#22FFFFFF">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Hidden"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <TextBlock Grid.Row="6" Text="{Binding StatusMessage}"
                               Foreground="#E8FAFF" TextWrapping="Wrap"
                               LineHeight="19" Margin="0,12,0,8"/>

                    <Border Grid.Row="7" Background="#18FF8F8F"
                            BorderBrush="#55FFC2C2" BorderThickness="1"
                            Padding="10" MinHeight="54">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Hidden"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="诊断未完成" Foreground="#FFDADA" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFF1F1"
                                       TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="8" Text="分析过程中不会执行任何硬件调节操作。"
                               Foreground="#8FCADD" FontSize="10"
                               VerticalAlignment="Bottom" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="诊断仅提供分析建议，不会自动修改 BIOS、硬件电压或系统保护设置。"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   FontSize="11" Margin="0,13,0,0"/>
    </Grid>
</Page>
