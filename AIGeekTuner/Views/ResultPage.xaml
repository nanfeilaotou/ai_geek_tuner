<Page x:Class="AIGeekTuner.Views.ResultPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="clr-namespace:AIGeekTuner.Models"
      Title="ResultPage" Background="Transparent">
    <Page.Resources>
        <Style x:Key="ReportSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="ReportSubtleRowStyle" TargetType="Border">
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#16FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <Style x:Key="ReportProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="7"/>
            <Setter Property="Background" Value="#25FFFFFF"/>
            <Setter Property="Foreground" Value="#9BE8F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid Background="{TemplateBinding Background}" ClipToBounds="True">
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ReportButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <Style x:Key="ReportActionButtonStyle" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource ReportButtonTemplate}"/>
            <Setter Property="Background" Value="#9BE8F7"/>
            <Setter Property="Foreground" Value="#075581"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C4F3FB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,19">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="诊断报告" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="结构化 AI 硬件诊断结果与本地 SafetyGuard 审核状态"
                               Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding CompletedAtText}"
                               Foreground="#AFE0EF" FontSize="11"
                               HorizontalAlignment="Right"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                Visibility="{Binding DiagnosticContentVisibility}">
                        <TextBlock Text="{Binding ExportStatusMessage}"
                                   Foreground="#C9F5E1" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="导出报告"
                                Command="{Binding ExportReportCommand}"
                                Style="{StaticResource ReportActionButtonStyle}"
                                Padding="15,7"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Visibility="{Binding EmptyVisibility}"
                    Background="#0DFFFFFF" MinHeight="360" Padding="28">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="450">
                    <Border Width="52" Height="52" Background="#18FFFFFF" Margin="0,0,0,16">
                        <TextBlock Text="▧" Foreground="#BDEFFA" FontSize="26"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="暂无诊断报告" Foreground="White" FontSize="20"
                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="请先前往 AI 智能诊断页面完成一次分析。报告将在本地生成，不会展示任何伪造或示例结果。"
                               Foreground="#BDE4F1" TextWrapping="Wrap" TextAlignment="Center"
                               LineHeight="20" Margin="0,9,0,20"/>
                    <Button Content="前往 AI 智能诊断"
                            Command="{Binding StartNewDiagnosisCommand}"
                            Style="{StaticResource ReportActionButtonStyle}"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Visibility="{Binding DiagnosticContentVisibility}">
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.75*"/>
                        <ColumnDefinition Width="0.8*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource ReportSectionStyle}" Margin="0,0,15,0">
                        <StackPanel>
                            <TextBlock Text="01  诊断概览" Foreground="#BDEFFA" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Result.Summary}" Foreground="White"
                                       FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                                       LineHeight="28" Margin="0,13,0,0"/>
                            <Border Height="1" Background="#20FFFFFF" Margin="0,16,0,13"/>
                            <TextBlock Text="根本原因" Foreground="#A9D9E9" FontSize="11"/>
                            <TextBlock Text="{Binding Result.RootCause}" Foreground="#F2FCFF"
                                       FontSize="13" TextWrapping="Wrap" LineHeight="21" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource ReportSectionStyle}">
                        <StackPanel>
                            <TextBlock Text="02  风险与可信度" Foreground="#BDEFFA" FontSize="12" FontWeight="SemiBold"/>
                            <Grid Margin="0,14,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="AI 置信度" Foreground="#A9D9E9" FontSize="11" VerticalAlignment="Bottom"/>
                                <TextBlock Grid.Column="1" Text="{Binding ConfidenceText}"
                                           Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                            </Grid>
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding ConfidenceValue, Mode=OneWay}"
                                         Style="{StaticResource ReportProgressStyle}"/>

                            <TextBlock Text="风险等级" Foreground="#A9D9E9" FontSize="11" Margin="0,18,0,6"/>
                            <Border Background="#18FFFFFF" Padding="11,7" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Result.RiskLevel}" FontSize="14" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#D7F6FF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Result.RiskLevel}" Value="{x:Static models:DiagnosticRiskLevel.Low}">
                                                    <Setter Property="Foreground" Value="#A9F2D0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Result.RiskLevel}" Value="{x:Static models:DiagnosticRiskLevel.Medium}">
                                                    <Setter Property="Foreground" Value="#FFE08A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Result.RiskLevel}" Value="{x:Static models:DiagnosticRiskLevel.High}">
                                                    <Setter Property="Foreground" Value="#FFB07A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Result.RiskLevel}" Value="{x:Static models:DiagnosticRiskLevel.Critical}">
                                                    <Setter Property="Foreground" Value="#FF9696"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource ReportSectionStyle}" Margin="0,0,0,15">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,13">
                            <TextBlock Text="03  证据链" Foreground="#BDEFFA" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="事实与 AI 推测分开展示，推测不会被标记为事实。"
                                       Foreground="#A9D9E9" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#0C9DE6C8" BorderBrush="#35A9F2D0"
                                    BorderThickness="3,0,0,0" Padding="15">
                                <StackPanel>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✓" Foreground="#A9F2D0" FontWeight="Bold" Margin="0,0,8,0"/>
                                            <TextBlock Text="事实证据" Foreground="White" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding FactEvidenceCountText}" Foreground="#A9D9E9" FontSize="11"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding FactEvidence}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ReportSubtleRowStyle}">
                                                    <TextBlock Text="{Binding Description}" Foreground="#F3FFFB"
                                                               TextWrapping="Wrap" LineHeight="19"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#0CE0A72E" BorderBrush="#45FFE08A"
                                    BorderThickness="3,0,0,0" Padding="15">
                                <StackPanel>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="◇" Foreground="#FFE08A" FontWeight="Bold" Margin="0,0,8,0"/>
                                            <TextBlock Text="AI 推测" Foreground="White" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding InferenceEvidenceCountText}" Foreground="#A9D9E9" FontSize="11"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding InferenceEvidence}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ReportSubtleRowStyle}">
                                                    <TextBlock Text="{Binding Description}" Foreground="#FFF9E8"
                                                               TextWrapping="Wrap" LineHeight="19"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Visibility="{Binding RecommendationsVisibility}"
                        Style="{StaticResource ReportSectionStyle}" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="04  建议操作" Foreground="#BDEFFA" FontSize="12"
                                   FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Result.Recommendations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0AFFFFFF" BorderBrush="#16FFFFFF"
                                            BorderThickness="0,0,0,1" Padding="15,13">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Action}" Foreground="White"
                                                           FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Reason}" Foreground="#CBEAF4"
                                                           FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,6,18,0"/>
                                                <StackPanel Margin="0,9,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Precautions.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="注意事项" Foreground="#FFE08A" FontSize="11" FontWeight="SemiBold"/>
                                                    <ItemsControl ItemsSource="{Binding Precautions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" Foreground="#FFF1C7"
                                                                           FontSize="11" TextWrapping="Wrap" Margin="10,3,0,0"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>

                                            <Border Grid.Column="1" Background="#18FFFFFF" Padding="9,5"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding RiskLevel}" FontSize="11" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#D7F6FF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RiskLevel}" Value="{x:Static models:DiagnosticRiskLevel.Low}">
                                                                    <Setter Property="Foreground" Value="#A9F2D0"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RiskLevel}" Value="{x:Static models:DiagnosticRiskLevel.Medium}">
                                                                    <Setter Property="Foreground" Value="#FFE08A"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RiskLevel}" Value="{x:Static models:DiagnosticRiskLevel.High}">
                                                                    <Setter Property="Foreground" Value="#FFB07A"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RiskLevel}" Value="{x:Static models:DiagnosticRiskLevel.Critical}">
                                                                    <Setter Property="Foreground" Value="#FF9696"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ReportSectionStyle}">
                    <StackPanel>
                        <TextBlock Text="05  SafetyGuard 安全状态" Foreground="#BDEFFA"
                                   FontSize="12" FontWeight="SemiBold" Margin="0,0,0,11"/>

                        <Border Visibility="{Binding ApprovedVisibility}" Background="#14A9F2D0"
                                BorderBrush="#50A9F2D0" BorderThickness="3,0,0,0" Padding="15">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="✓" Foreground="#A9F2D0" FontSize="20" FontWeight="Bold" Margin="0,0,13,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="安全检查通过" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="本地 SafetyGuard 未发现需要拦截的危险参数或危险操作。"
                                               Foreground="#CFF6E4" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Visibility="{Binding WarningVisibility}" Background="#16E0A72E"
                                BorderBrush="#65FFE08A" BorderThickness="3,0,0,0" Padding="15">
                            <StackPanel>
                                <TextBlock Text="安全检查通过，但包含警告" Foreground="#FFE08A"
                                           FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="AI 结果仍可查看，请在执行建议前确认以下 SafetyGuard 提示："
                                           Foreground="#FFF3CF" TextWrapping="Wrap" Margin="0,4,0,7"/>
                                <ItemsControl ItemsSource="{Binding SafetyMessages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="#FFF0C2"
                                                       TextWrapping="Wrap" Margin="10,3,0,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Visibility="{Binding RejectedVisibility}" Background="#20D45555"
                                BorderBrush="#75FFAAAA" BorderThickness="3,0,0,0" Padding="15">
                            <StackPanel>
                                <TextBlock Text="本地 SafetyGuard 已拦截本次 AI 输出"
                                           Foreground="#FFD1D1" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="本次 AI 输出包含潜在危险参数或危险操作，已被本地 SafetyGuard 拦截。"
                                           Foreground="White" TextWrapping="Wrap" Margin="0,5,0,7"/>
                                <TextBlock Text="危险建议已隐藏，程序不会执行任何硬件、BIOS 或系统修改。"
                                           Foreground="#FFDADA" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding SafetyMessages}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="#FFE5B8"
                                                       TextWrapping="Wrap" Margin="10,3,0,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
