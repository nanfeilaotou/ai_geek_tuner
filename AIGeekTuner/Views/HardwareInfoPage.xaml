<Page x:Class="AIGeekTuner.Views.HardwareInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:viewModels="clr-namespace:AIGeekTuner.ViewModels"
      Title="HardwareInfoPage" Background="Transparent"
      Loaded="OnLoaded">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="HardwareGroupTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ECFAFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HardwareFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A9D9E9"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="HardwareFieldValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>

        <Style x:Key="HardwareFieldRowStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,8"/>
        </Style>

        <Style x:Key="HardwareSpecGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="#08FFFFFF"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SensorGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="#0CFFFFFF"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="14,13"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>

        <DataTemplate DataType="{x:Type viewModels:HardwareSensorItemViewModel}">
            <Grid Margin="0,7,0,0" ToolTip="{Binding Source}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="#B4DEEB"
                           FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}"
                           Foreground="White" FontSize="14" FontWeight="SemiBold"
                           Margin="16,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- 数据源状态行的状态色 -->
        <Style x:Key="DataSourceGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#6FA9C1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="Ready">
                    <Setter Property="Foreground" Value="#A9F2D0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Degraded">
                    <Setter Property="Foreground" Value="#FFE08A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="NeedsConfiguration">
                    <Setter Property="Foreground" Value="#FFE08A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                    <Setter Property="Foreground" Value="#FFD1D1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,24,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,19">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="硬件信息" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="详细硬件规格与当前实时传感器状态"
                               Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Button Content="{Binding RefreshSensorButtonText}"
                            Command="{Binding RefreshSensorsCommand}"
                            Style="{StaticResource TechButtonStyle}"
                            Padding="18,8" MinWidth="132"/>
                    <TextBlock Text="{Binding SensorCapturedAt, StringFormat=采集时间：{0}}"
                               Foreground="#A9D9E9" FontSize="10"
                               HorizontalAlignment="Right" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.52*" MinWidth="450"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="0.88*" MinWidth="280"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#0DFFFFFF" Padding="19,17,19,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="详细硬件规格" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Grid.Column="1" Height="1" Background="#20FFFFFF"
                                    Margin="14,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Windows WMI"
                                       Foreground="#9FD9EA" FontSize="10"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Border Style="{StaticResource HardwareSpecGroupStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#70DDF5"/>
                                    <TextBlock Grid.Column="1" Text="CPU"
                                               Style="{StaticResource HardwareGroupTitleStyle}"
                                               Margin="9,0,0,0"/>
                                </Grid>
                                <Border Style="{StaticResource HardwareFieldRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="128"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="型号" Style="{StaticResource HardwareFieldLabelStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CpuName}"
                                                   Style="{StaticResource HardwareFieldValueStyle}"/>
                                    </Grid>
                                </Border>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="128"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="物理核心数" Style="{StaticResource HardwareFieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CpuPhysicalCores}"
                                               Style="{StaticResource HardwareFieldValueStyle}"/>
                                    <TextBlock Grid.Column="2" Text="逻辑线程数"
                                               Style="{StaticResource HardwareFieldLabelStyle}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding CpuLogicalProcessors}"
                                               Style="{StaticResource HardwareFieldValueStyle}"/>
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="128"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="WMI 报告最高频率"
                                               Style="{StaticResource HardwareFieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CpuMaxClock}"
                                               Style="{StaticResource HardwareFieldValueStyle}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HardwareSpecGroupStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#70DDF5"/>
                                    <TextBlock Grid.Column="1" Text="GPU"
                                               Style="{StaticResource HardwareGroupTitleStyle}"
                                               Margin="9,0,0,0"/>
                                </Grid>
                                <Border Padding="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="128"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="GPU 型号列表"
                                                   Style="{StaticResource HardwareFieldLabelStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding GpuDetails}"
                                                   Style="{StaticResource HardwareFieldValueStyle}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HardwareSpecGroupStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#70DDF5"/>
                                    <TextBlock Grid.Column="1" Text="主板"
                                               Style="{StaticResource HardwareGroupTitleStyle}"
                                               Margin="9,0,0,0"/>
                                </Grid>
                                <Border Style="{StaticResource HardwareFieldRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="128"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="厂商" Style="{StaticResource HardwareFieldLabelStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MotherboardManufacturer}"
                                                   Style="{StaticResource HardwareFieldValueStyle}"/>
                                    </Grid>
                                </Border>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="128"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="型号" Style="{StaticResource HardwareFieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding MotherboardProduct}"
                                               Style="{StaticResource HardwareFieldValueStyle}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HardwareSpecGroupStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#70DDF5"/>
                                    <TextBlock Grid.Column="1" Text="内存"
                                               Style="{StaticResource HardwareGroupTitleStyle}"
                                               Margin="9,0,0,0"/>
                                </Grid>
                                <Border Style="{StaticResource HardwareFieldRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="128"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="总容量" Style="{StaticResource HardwareFieldLabelStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MemoryCapacity}"
                                                   Style="{StaticResource HardwareFieldValueStyle}"/>
                                        <TextBlock Grid.Column="2" Text="内存条数量"
                                                   Style="{StaticResource HardwareFieldLabelStyle}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding MemoryModuleCount}"
                                                   Style="{StaticResource HardwareFieldValueStyle}"/>
                                    </Grid>
                                </Border>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="128"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="厂商" Style="{StaticResource HardwareFieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding MemoryManufacturers}"
                                               Style="{StaticResource HardwareFieldValueStyle}"/>
                                    <TextBlock Grid.Row="1" Text="ConfiguredClockSpeed"
                                               Style="{StaticResource HardwareFieldLabelStyle}"
                                               Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{Binding MemorySpeeds}"
                                               Style="{StaticResource HardwareFieldValueStyle}"
                                               Margin="0,8,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HardwareSpecGroupStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#70DDF5"/>
                                    <TextBlock Grid.Column="1" Text="磁盘"
                                               Style="{StaticResource HardwareGroupTitleStyle}"
                                               Margin="9,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="128"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="型号 / 容量 / 类型"
                                               Style="{StaticResource HardwareFieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StorageDevices}"
                                               Style="{StaticResource HardwareFieldValueStyle}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HardwareSpecGroupStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#70DDF5"/>
                                    <TextBlock Grid.Column="1" Text="操作系统"
                                               Style="{StaticResource HardwareGroupTitleStyle}"
                                               Margin="9,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="128"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="系统名称" Style="{StaticResource HardwareFieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OperatingSystemName}"
                                               Style="{StaticResource HardwareFieldValueStyle}"/>
                                    <TextBlock Grid.Row="1" Text="版本"
                                               Style="{StaticResource HardwareFieldLabelStyle}"
                                               Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{Binding OperatingSystemVersion}"
                                               Style="{StaticResource HardwareFieldValueStyle}"
                                               Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="2" Text="架构"
                                               Style="{StaticResource HardwareFieldLabelStyle}"
                                               Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Text="{Binding OperatingSystemArchitecture}"
                                               Style="{StaticResource HardwareFieldValueStyle}"
                                               Margin="0,8,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding DetectedAt, StringFormat=静态规格检测时间：{0}}"
                                   Foreground="#92CDDF" FontSize="10"
                                   HorizontalAlignment="Right" Margin="0,0,2,2"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#12FFFFFF"
                        Padding="18,17" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="实时状态" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="{Binding SensorStatus}"
                                           Foreground="#B5E3F0" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,4,10,0"/>
                            </StackPanel>
                            <Ellipse Grid.Column="1" Width="9" Height="9"
                                     VerticalAlignment="Top" Margin="8,5,0,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#6FA9C1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSensorRefreshing}" Value="True">
                                                <Setter Property="Fill" Value="#FFE08A"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasSensorData}" Value="True">
                                                <Setter Property="Fill" Value="#A9F2D0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>

                        <!-- V2-M1 数据源状态（紧凑区） -->
                        <Border Background="#08FFFFFF" Padding="13,10" Margin="0,0,0,9"
                                Visibility="{Binding HasDataSources, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="数据源" Foreground="#9FD9EA"
                                               FontSize="11" FontWeight="SemiBold"/>
                                    <Button Content="查看数据源详情"
                                            Click="OnShowDataSourcesDetail"
                                            HorizontalAlignment="Right"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="#7FB6CB" FontSize="10" Cursor="Hand"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding DataSources}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <TextBlock Text="{Binding StatusGlyph}"
                                                           Style="{StaticResource DataSourceGlyphStyle}"/>
                                                <TextBlock Text="{Binding SourceName}"
                                                           Foreground="#ECFAFF" FontSize="11"
                                                           FontWeight="SemiBold" Margin="8,0,0,0"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DetailLine}"
                                                           Foreground="#A9D9E9" FontSize="10"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="190" Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           ToolTip="{Binding DetailLine}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- V2-M1 canonical 核心指标 -->
                        <Border Background="#0AFFFFFF" Padding="14,12" Margin="0,0,0,9"
                                Visibility="{Binding HasCoreMetrics, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="实时数据 · 核心指标"
                                           Foreground="#D9F7FF" FontSize="12"
                                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding CoreMetricGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:HardwareSensorGroupViewModel}">
                                            <Border Style="{StaticResource SensorGroupStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="#D9F7FF"
                                                               FontSize="12" FontWeight="SemiBold"/>
                                                    <ItemsControl ItemsSource="{Binding Items}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="来源见各项悬停提示；同一指标按固定优先级选择数据源，不做多源平均。"
                                           Foreground="#7FB6CB" FontSize="9" Margin="0,6,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding SensorGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:HardwareSensorGroupViewModel}">
                                    <Border Style="{StaticResource SensorGroupStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="#D9F7FF"
                                                       FontSize="12" FontWeight="SemiBold"/>
                                            <ItemsControl ItemsSource="{Binding Items}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="#0CFFFFFF" Padding="18,24"
                                MinHeight="170">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSensorData}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="◌" Foreground="#A9D9E9" FontSize="25"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="当前设备未读取到可用实时传感器数据。"
                                           Foreground="White" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="0,10,0,0"/>
                                <TextBlock Text="静态硬件规格不受影响。"
                                           Foreground="#A9D9E9" FontSize="10"
                                           HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#09FFFFFF" BorderBrush="#16FFFFFF"
                                BorderThickness="0,1,0,0" Padding="0,12,0,0"
                                Margin="0,11,0,0">
                            <TextBlock Text="部分传感器可能需要管理员权限才能读取；未读取到的字段不会使用默认值填充。"
                                       Foreground="#A9D9E9" FontSize="10"
                                       TextWrapping="Wrap" LineHeight="16"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
